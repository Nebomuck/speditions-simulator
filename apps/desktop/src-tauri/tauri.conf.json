{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speditions-Simulator",
  "version": "0.1.0",
  "identifier": "de.spedsim.desktop",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Speditions-Simulator",
        "width": 1600,
        "height": 950,
        "minWidth": 1200,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "SimulationGame",
    "shortDescription": "Speditions- und Unternehmenssimulator",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
