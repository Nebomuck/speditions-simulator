{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speditions-Simulator",
  "version": "0.4.0",
  "identifier": "de.spedsim.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:server --prefix ../.. && npm run build --prefix ../../apps/client",
    "beforeDevCommand": "",
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Speditions-Simulator",
        "width": 1600,
        "height": 950,
        "minWidth": 1200,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "SimulationGame",
    "shortDescription": "Speditions- und Unternehmenssimulator",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/spedsim-server",
      "binaries/cloudflared"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGODI5MDRDODhEMTc3OTYKUldTV2Q5R0lUSkNDMzNmMDFEbFVmT2RZUXdlVHowYVNDMHdaWHo4dkRiT1NJYlcyaHQ1UWRDZDUK",
      "endpoints": [
        "https://github.com/Nebomuck/speditions-simulator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
